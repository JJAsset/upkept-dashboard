{
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",
  "color": {
    "$type": "color",
    "palette": {
      "$description": "Base tonal palettes. Each step is the default (light) value. Dark mode values will be added per-token via $extensions.modes.dark.",
      "identity": {
        "$description": "Main product idetity color - this is typicaly the color that sets the visual tone of the application. It's used for surfaces, but typically not for actionable elements. For example, it would be used for the background of a menu or sidebar, but not for buttons or links.",
        "25": { "$value": "#F6F6F9" },
        "50": { "$value": "#EEEEF2" },
        "100": { "$value": "#DFE1EC" },
        "200": { "$value": "#CCD0E0" },
        "300": { "$value": "#848FC2" },
        "400": { "$value": "#6270B2" },
        "500": { "$value": "#3F50A2" },
        "600": { "$value": "#283986" },
        "700": { "$value": "#162464" },
        "800": { "$value": "#141F52" },
        "900": { "$value": "#061041" },
        "950": { "$value": "#030821" }
      },
      "primary": {
        "$description": "Primary action color - used for main primary actions like buttons and other primary interactive elements. Used to draw attention to key actions. Never used on large background surfaces or for decorative purposes.",
        "25": { "$value": "#F0F3FF" },
        "50": { "$value": "#E0E6FF" },
        "100": { "$value": "#C2CDFF" },
        "200": { "$value": "#8FA4FF" },
        "300": { "$value": "#5C7BFF" },
        "400": { "$value": "#002FF5" },
        "500": { "$value": "#0025C2" },
        "600": { "$value": "#0020A3" },
        "700": { "$value": "#001980" },
        "800": { "$value": "#00125D" },
        "900": { "$value": "#000C3D" },
        "950": { "$value": "#00061F" }
      },
      "secondary": {
        "$description": "Secondary color - typically used for secondary actions and accents, for example secondary buttons and highlight/active states. Use only on light backgrounds; avoid for example as active state on top of the identity color.",
        "25": { "$value": "#F7FBFA" },
        "50": { "$value": "#EEF7F4" },
        "100": { "$value": "#DCEFEA" },
        "200": { "$value": "#B9DFD5" },
        "300": { "$value": "#96CFC0" },
        "400": { "$value": "#73BFAB" },
        "500": { "$value": "#50AF96" },
        "600": { "$value": "#408C78" },
        "700": { "$value": "#30695A" },
        "800": { "$value": "#20463C" },
        "900": { "$value": "#10231E" },
        "950": { "$value": "#0B1815" }
      },
      "neutral": {
        "$description": "Neutral colors for backgrounds, surfaces, text, borders.",
        "0": { "$value": "#ffffff" },
        "25": { "$value": "#F7F7F8" },
        "50": { "$value": "#EEEFF1" },
        "100": { "$value": "#DEDFE3" },
        "200": { "$value": "#C3C4CB" },
        "300": { "$value": "#A7A9B4" },
        "400": { "$value": "#717484" },
        "500": { "$value": "#595C69" },
        "600": { "$value": "#4B4E58" },
        "700": { "$value": "#3B3D45" },
        "800": { "$value": "#2B2C32" },
        "900": { "$value": "#1C1D21" },
        "950": { "$value": "#0E0F11" },
        "1000": { "$value": "#000000" }
      },
      "danger": {
        "$description": "Colors used only to communicate error states and destructive actions. Avoid using these colors for decorative purposes or non-destructive accents to maintain their semantic meaning and ensure they stand out when used for their intended purpose.",
        "25": { "$value": "#fef6f6" },
        "50": { "$value": "#feecec" },
        "100": { "$value": "#fee2e2" },
        "200": { "$value": "#fecaca" },
        "300": { "$value": "#fca5a5" },
        "400": { "$value": "#f87171" },
        "500": { "$value": "#ef4444" },
        "600": { "$value": "#dc2626" },
        "700": { "$value": "#b91c1c" },
        "800": { "$value": "#991b1b" },
        "900": { "$value": "#7f1d1d" },
        "950": { "$value": "#450a0a" }
      },
      "warning": {
        "$description": "Colors used only to communicate warning states and caution alerts. Avoid using these colors for decorative purposes or non-destructive accents to maintain their semantic meaning and ensure they stand out when used for their intended purpose.",
        "25": { "$value": "#FFFCF2" },
        "50": { "$value": "#FFF7E3" },
        "100": { "$value": "#FFF2D4" },
        "200": { "$value": "#FFEDC5" },
        "300": { "$value": "#FFE8B6" },
        "400": { "$value": "#FEE2A8" },
        "500": { "$value": "#FBE39D" },
        "600": { "$value": "#F3D682" },
        "700": { "$value": "#E2BD50" },
        "800": { "$value": "#CFA630" },
        "900": { "$value": "#4D422B" },
        "950": { "$value": "#2A2418" }
      },
      "success": {
        "$description": "Colors used only to communicate success states and positive feedback. Aliases the secondary palette. Avoid using these colors for decorative purposes or non-destructive accents to maintain their semantic meaning and ensure they stand out when used for their intended purpose.",
        "25": { "$value": "{color.palette.secondary.25}" },
        "50": { "$value": "{color.palette.secondary.50}" },
        "100": { "$value": "{color.palette.secondary.100}" },
        "200": { "$value": "{color.palette.secondary.200}" },
        "300": { "$value": "{color.palette.secondary.300}" },
        "400": { "$value": "{color.palette.secondary.400}" },
        "500": { "$value": "{color.palette.secondary.500}" },
        "600": { "$value": "{color.palette.secondary.600}" },
        "700": { "$value": "{color.palette.secondary.700}" },
        "800": { "$value": "{color.palette.secondary.800}" },
        "900": { "$value": "{color.palette.secondary.900}" },
        "950": { "$value": "{color.palette.secondary.950}" }
      },
      "info": {
        "$description": "Colors used only to communicate informational states and neutral feedback. Aliases the identity palette. Avoid using these colors for decorative purposes or non-destructive accents to maintain their semantic meaning and ensure they stand out when used for their intended purpose.",
        "25": { "$value": "{color.palette.identity.25}" },
        "50": { "$value": "{color.palette.identity.50}" },
        "100": { "$value": "{color.palette.identity.100}" },
        "200": { "$value": "{color.palette.identity.200}" },
        "300": { "$value": "{color.palette.identity.300}" },
        "400": { "$value": "{color.palette.identity.400}" },
        "500": { "$value": "{color.palette.identity.500}" },
        "600": { "$value": "{color.palette.identity.600}" },
        "700": { "$value": "{color.palette.identity.700}" },
        "800": { "$value": "{color.palette.identity.800}" },
        "900": { "$value": "{color.palette.identity.900}" },
        "950": { "$value": "{color.palette.identity.950}" }
      }
    },
    "semantic": {
      "$description": "Semantic color tokens. Use these instead of raw palette values in components and layouts.",
      "surface": {
        "$description": "Page and component surface colors for backgrounds, text, and borders.",
        "bg": {
          "$value": "{color.palette.neutral.0}",
          "$description": "Main page and card background"
        },
        "fg": {
          "$value": "{color.palette.neutral.950}",
          "$description": "Primary body text and icons"
        },
        "fg-muted": {
          "$value": "{color.palette.neutral.500}",
          "$description": "Secondary, placeholder, and muted text"
        },
        "border": {
          "$value": "{color.palette.neutral.100}",
          "$description": "Default border and divider color"
        }
      },
      "card": {
        "$description": "Card surface tokens — mirrors surface for consistency.",
        "bg": {
          "$value": "{color.semantic.surface.bg}",
          "$description": "Card background"
        },
        "fg": {
          "$value": "{color.semantic.surface.fg}",
          "$description": "Card primary text and icons"
        },
        "fg-muted": {
          "$value": "{color.semantic.surface.fg-muted}",
          "$description": "Card secondary and muted text"
        },
        "border": {
          "$value": "{color.semantic.surface.border}",
          "$description": "Card border color"
        }
      },
      "button": {
        "$description": "Button color tokens",
        "primary": {
          "$description": "High-emphasis action button. Typically used only once per page for the main call to action.",
          "bg": {
            "$value": "{color.palette.primary.500}",
            "$description": "Primary button background"
          },
          "fg": {
            "$value": "{color.palette.neutral.0}",
            "$description": "Primary button label and icon color"
          }
        },
        "secondary": {
          "$description": "Medium-emphasis action button. This button type adds a dash of secondary color to the interface, so prefer to use this over the outline button unless the action should be very low emphasis.",
          "bg": {
            "$value": "{color.palette.secondary.100}",
            "$description": "Secondary button background"
          },
          "fg": {
            "$value": "{color.palette.primary.500}",
            "$description": "Secondary button label and icon color"
          }
        },
        "outline": {
          "$description": "Low-emphasis button with a visible border and no fill. Used for actions that should not be emphasized or if there are a lot of buttons of the same type in the UI.",
          "fg": {
            "$value": "{color.palette.primary.500}",
            "$description": "Outline button label and icon color"
          },
          "outline": {
            "$value": "{color.palette.identity.200}",
            "$description": "Outline button border color"
          }
        },
        "ghost": {
          "$description": "Minimal-emphasis button with no background or border. Used for low emphasis actions, toolbar buttons, or actions where the button should blend into the surrounding content.",
          "fg": {
            "$value": "{color.palette.primary.500}",
            "$description": "Ghost button label and icon color"
          }
        }
      },
      "select": {
        "$description": "Select / dropdown trigger tokens. Bordered, no fill.",
        "fg": {
          "$value": "{color.palette.identity.800}",
          "$description": "Select label and icon color"
        },
        "border": {
          "$value": "{color.palette.identity.200}",
          "$description": "Select border color"
        }
      },
      "link": {
        "$description": "Hyperlink text color tokens.",
        "fg": {
          "$value": "{color.palette.primary.500}",
          "$description": "Link text color"
        }
      },
      "input": {
        "$description": "Text input field color tokens.",
        "border": {
          "$value": "{color.palette.identity.200}",
          "$description": "Input border color"
        },
        "fg": {
          "$value": "{color.palette.neutral.950}",
          "$description": "Input text color"
        },
        "bg": {
          "$value": "{color.palette.neutral.0}",
          "$description": "Input background color"
        }
      },
      "checkbox": {
        "$description": "Checkbox color tokens.",
        "border": {
          "$value": "{color.palette.identity.200}",
          "$description": "Checkbox border color"
        },
        "bg": {
          "default": {
            "$value": "{color.palette.neutral.0}",
            "$description": "Checkbox background when unchecked"
          },
          "active": {
            "$value": "{color.palette.primary.500}",
            "$description": "Checkbox background when checked"
          }
        },
        "fg": {
          "$value": "{color.palette.neutral.0}",
          "$description": "Checkbox checkmark color"
        }
      },
      "radio": {
        "$description": "Radio button color tokens.",
        "border": {
          "$value": "{color.palette.identity.200}",
          "$description": "Radio border color"
        },
        "bg": {
          "default": {
            "$value": "{color.palette.neutral.0}",
            "$description": "Radio background when unselected"
          },
          "active": {
            "$value": "{color.palette.primary.500}",
            "$description": "Radio background when selected"
          }
        },
        "fg": {
          "$value": "{color.palette.neutral.0}",
          "$description": "Radio indicator color"
        }
      },
      "label": {
        "$description": "Form label color tokens.",
        "fg": {
          "$value": "{color.palette.neutral.950}",
          "$description": "Label text color"
        }
      },
      "menu": {
        "$description": "Navigation menu color tokens. Used for main menus like top nav, sidebar nav and bottom nav/tab bar on mobile.",
        "bg": {
          "$value": "{color.palette.identity.800}",
          "$description": "Menu background color"
        },
        "fg": {
          "$value": "{color.palette.identity.50}",
          "$description": "Menu item text and icon color"
        },
        "active": {
          "bg": {
            "$value": "{color.palette.secondary.100}",
            "$description": "Active/selected menu item background"
          },
          "fg": {
            "$value": "{color.palette.identity.800}",
            "$description": "Active/selected menu item text and icon color"
          }
        }
      },
      "switch": {
        "$description": "Toggle switch color tokens.",
        "bg": {
          "default": {
            "$value": "{color.palette.identity.200}",
            "$description": "Switch track background when off"
          },
          "active": {
            "$value": "{color.palette.primary.500}",
            "$description": "Switch track background when on"
          }
        },
        "fg": {
          "$value": "{color.palette.neutral.0}",
          "$description": "Switch thumb color"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Poppins",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "UI text, body copy, headings"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "Fira Code",
          "Menlo",
          "Monaco",
          "Courier New",
          "monospace"
        ],
        "$description": "Code, data, timestamps"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem",
        "$description": "Fine print, captions, labels"
      },
      "sm": {
        "$value": "0.875rem",
        "$description": "Secondary text, helper text"
      },
      "base": {
        "$value": "1rem",
        "$description": "Body text, default"
      },
      "lg": {
        "$value": "1.125rem",
        "$description": "Emphasized body text"
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "Typically heading 4"
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "Typically heading 3"
      },
      "3xl": {
        "$value": "1.875rem",
        "$description": "Typically heading 2"
      },
      "4xl": {
        "$value": "2.25rem",
        "$description": "Typically heading 1"
      },
      "5xl": {
        "$value": "3rem",
        "$description": "Display, hero headings"
      }
    },
    "weight": {
      "$type": "number",
      "thin": {
        "$value": 100
      },
      "extralight": {
        "$value": 200
      },
      "light": {
        "$value": 300
      },
      "normal": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      },
      "black": {
        "$value": 900
      }
    },
    "lineHeight": {
      "$type": "number",
      "$description": "Unitless line-height ratios — scale relative to the element's font size",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.25
      },
      "snug": {
        "$value": 1.375
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.625
      },
      "loose": {
        "$value": 2
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": {
        "$value": "-0.05em"
      },
      "tight": {
        "$value": "-0.025em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.025em"
      },
      "wider": {
        "$value": "0.05em"
      },
      "widest": {
        "$value": "0.1em"
      }
    }
  },
  "spacing": {
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    },
    "32": {
      "$value": "8rem"
    },
    "$type": "dimension",
    "$description": "4px base unit spacing system. All values are multiples of 4."
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation levels for establishing hierarchy and depth",
    "none": {
      "$value": {
        "offsetX": "0",
        "offsetY": "0",
        "blur": "0",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0)"
      },
      "$description": "Flat surfaces, inline elements"
    },
    "xs": {
      "$value": {
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0",
        "color": "rgba(0, 0, 0, 0.05)"
      },
      "$description": "Cards, panels at rest"
    },
    "sm": {
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "-1px",
          "color": "rgba(0, 0, 0, 0.1)"
        }
      ],
      "$description": "Hover states, dropdowns"
    },
    "md": {
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        {
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px",
          "color": "rgba(0, 0, 0, 0.1)"
        }
      ],
      "$description": "Popovers, tooltips"
    },
    "lg": {
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "10px",
          "blur": "15px",
          "spread": "-3px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        {
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-4px",
          "color": "rgba(0, 0, 0, 0.1)"
        }
      ],
      "$description": "Modals, dialogs, overlays"
    },
    "xl": {
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "20px",
          "blur": "25px",
          "spread": "-5px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        {
          "offsetX": "0",
          "offsetY": "8px",
          "blur": "10px",
          "spread": "-6px",
          "color": "rgba(0, 0, 0, 0.1)"
        }
      ],
      "$description": "Maximum elevation (notifications)"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "1px",
        "$description": "Default borders, dividers"
      },
      "thick": {
        "$value": "2px",
        "$description": "Emphasized borders, selected states"
      },
      "focus": {
        "$value": "2px",
        "$description": "Focus indicators"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0"
      },
      "xs": {
        "$value": "0.125rem",
        "$description": "Extra subtle rounding"
      },
      "sm": {
        "$value": "0.25rem",
        "$description": "Subtle rounding, inline elements"
      },
      "md": {
        "$value": "0.375rem",
        "$description": "Default for most UI"
      },
      "lg": {
        "$value": "0.5rem",
        "$description": "Buttons, inputs, small cards"
      },
      "xl": {
        "$value": "0.75rem",
        "$description": "Cards, panels"
      },
      "2xl": {
        "$value": "1rem",
        "$description": "Large containers"
      },
      "3xl": {
        "$value": "1.5rem",
        "$description": "Hero sections"
      },
      "full": {
        "$value": "9999px",
        "$description": "Pills, avatars, badges"
      }
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "16px"
      },
      "md": {
        "$value": "24px"
      },
      "lg": {
        "$value": "32px"
      },
      "xl": {
        "$value": "48px"
      }
    },
    "strokeWidth": {
      "$type": "dimension",
      "$description": "Stroke/line thickness for outline-style icons. Note that you typically want to keep icon sizes and stroke widths uniform in your application. However, if you apply small or large icons, you typically want to adjust the stroke width to maintain visual balance and clarity. For example, very small icons may need thinner strokes to avoid looking too heavy, while very large icons may benefit from thicker strokes to prevent them from appearing too delicate or faint.",
      "thin": {
        "$value": "1px",
        "$description": "Delicate, decorative icons"
      },
      "regular": {
        "$value": "1.5px",
        "$description": "Default icon stroke"
      },
      "medium": {
        "$value": "2px",
        "$description": "Emphasized or larger icons"
      },
      "bold": {
        "$value": "2.5px",
        "$description": "High-emphasis or small icons needing visibility"
      }
    }
  }
}